{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Launch Web Dashboard (UI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_ui.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug: Local Invoice Demo (Azurite)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_local_demo.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug: Accuracy Benchmark",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/evaluation/evaluate_accuracy.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Debug: Pytest Full Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Attach to Python Functions",
      "type": "debugpy",
      "request": "attach",
      "port": 9091,
      "preLaunchTask": "func: host start"
    }
  ]
}
