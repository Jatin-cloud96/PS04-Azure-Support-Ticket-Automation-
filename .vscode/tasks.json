{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Azurite Emulator",
      "type": "shell",
      "command": "azurite",
      "args": [
        "--silent",
        "--skipApiVersionCheck",
        "--location",
        "${workspaceFolder}/.azurite",
        "--blobHost",
        "127.0.0.1",
        "--blobPort",
        "10000"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Launch Web Dashboard (UI)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/scripts/run_ui.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Local Demonstration",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/scripts/run_local_demo.py"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run Pytest Suite",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/pytest.exe",
      "args": [
        "-v"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/pip.exe",
      "args": [
        "install",
        "-r",
        "requirements.txt"
      ],
      "problemMatcher": []
    },
    {
      "type": "func",
      "label": "func: host start",
      "command": "host start",
      "problemMatcher": "$func-python-watch",
      "isBackground": true,
      "dependsOn": "Start Azurite Emulator"
    }
  ]
}
